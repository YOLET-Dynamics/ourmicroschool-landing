---
export type BrandIconName =
  | "learner"
  | "streak"
  | "spark"
  | "path"
  | "step"
  | "autosave"
  | "quiz"
  | "progress"
  | "message"
  | "educators"
  | "family"
  | "calm"
  | "devices"
  | "lock"
  | "celebrate";

type Props = { name: BrandIconName };
const { name } = Astro.props;
---

<svg class="brand-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {name === "learner" && <><circle cx="12" cy="8" r="3"></circle><path d="M6.5 19c.7-3.3 2.5-5 5.5-5s4.8 1.7 5.5 5"></path><path class="accent" d="m18.5 5 .5 1.3 1.4.5-1.4.5-.5 1.3-.5-1.3-1.4-.5 1.4-.5.5-1.3Z"></path></>}
  {name === "streak" && <path d="M13.5 3.5c.6 3-2.6 3.8-2 6.4.8-.6 1.7-1.5 2-2.5 2.2 2.2 3.7 4.5 3.1 7.5-.5 2.9-2.5 4.8-5.2 4.8-3 0-5-2.2-5-5.1 0-3 2.1-5.6 4.2-7.8-.1 2 .6 2.9 1.2 3.3-.1-2.8 2.1-3.8 1.7-6.6Z"></path>}
  {name === "spark" && <path d="m12 3 2.1 5 5.4.5-4.1 3.5 1.2 5.3-4.6-2.8-4.6 2.8 1.2-5.3-4.1-3.5L9.9 8 12 3Z"></path>}
  {name === "path" && <><path d="M5 19c0-4.5 5-3.8 5-7.5S16 8.8 18 5"></path><circle cx="5" cy="19" r="1.6"></circle><circle cx="10" cy="11.5" r="1.6"></circle><circle cx="18" cy="5" r="1.6"></circle></>}
  {name === "step" && <><path d="M4 18h5v-4h5v-4h6"></path><circle class="accent" cx="6.5" cy="15.5" r="1.25"></circle><circle cx="17" cy="6" r="2"></circle></>}
  {name === "autosave" && <><path d="M7 3.5h8l3 3V12"></path><path d="M16 20.5H7a2 2 0 0 1-2-2v-13a2 2 0 0 1 2-2"></path><path d="m15 15 2 2 3.5-4"></path><path d="M9 8h5M9 11h4"></path></>}
  {name === "quiz" && <><rect x="5" y="3.5" width="14" height="17" rx="2"></rect><path d="m8 9 1.4 1.4L12 7.8M13.5 10H16M8 15h8M8 17.5h5"></path></>}
  {name === "progress" && <><path d="M5 19V13M10 19V9M15 19v-4M20 19V5"></path><path d="m5 9 5-3 5 2 5-5"></path></>}
  {name === "message" && <><path d="M5 5.5h14a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2h-8l-4.5 3v-3H5a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2Z"></path><circle class="accent" cx="8" cy="11" r=".8"></circle><circle class="accent" cx="12" cy="11" r=".8"></circle><circle class="accent" cx="16" cy="11" r=".8"></circle></>}
  {name === "educators" && <><path d="M3.5 6.5c3-1 5.8-.4 8.5 1.4 2.7-1.8 5.5-2.4 8.5-1.4v11c-3-.8-5.8-.2-8.5 1.5-2.7-1.7-5.5-2.3-8.5-1.5v-11Z"></path><path d="M12 8v11"></path><circle class="accent" cx="7.5" cy="11" r="1.1"></circle><path d="M5.8 14c.5-1 1-1.5 1.7-1.5s1.3.5 1.7 1.5"></path></>}
  {name === "family" && <><circle cx="12" cy="7" r="2.5"></circle><circle cx="6.5" cy="10" r="2"></circle><circle cx="17.5" cy="10" r="2"></circle><path d="M8 19c.4-3.6 1.7-5.3 4-5.3s3.6 1.7 4 5.3M2.8 19c.3-2.8 1.5-4.2 3.7-4.2M21.2 19c-.3-2.8-1.5-4.2-3.7-4.2"></path></>}
  {name === "calm" && <><path d="M12 20v-8"></path><path d="M12 14c-5 0-7.5-2.5-7.5-7.5 5 0 7.5 2.5 7.5 7.5ZM12 12c0-4.4 2.3-6.7 6.8-6.7 0 4.4-2.3 6.7-6.8 6.7Z"></path></>}
  {name === "devices" && <><rect x="3" y="4" width="14" height="10" rx="1.5"></rect><path d="M8 18h4M10 14v4"></path><rect x="15" y="9" width="6" height="11" rx="1.3"></rect><path d="M17.5 17.5h1"></path></>}
  {name === "lock" && <><rect x="5" y="10" width="14" height="10" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"></path><circle class="accent" cx="12" cy="15" r="1.2"></circle></>}
  {name === "celebrate" && <><path d="m9 14 2 2 4-5"></path><circle cx="12" cy="14" r="6"></circle><path d="M12 3V1M5.5 5.5 4 4M18.5 5.5 20 4M4 12H2M22 12h-2"></path></>}
</svg>

<style>
  .brand-icon {
    width: 1em;
    height: 1em;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.65;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .brand-icon .accent {
    fill: currentColor;
    stroke: none;
  }
</style>
