---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/" aria-label="OurMicroSchool home">
        <img src="/logos/OMS_LogoDesign_01-09.png" width="3000" height="2365" alt="" loading="lazy" />
        <strong>OurMicroSchool</strong>
      </a>
      <p>Calm, capable tools for microschools, teachers, students, and families.</p>
    </div>

    <nav class="footer-links" aria-label="Footer navigation">
      <div>
        <strong>Explore</strong>
        <a href="/#how">How it works</a>
        <a href="/#roles">For everyone</a>
        <a href="/#features">Features</a>
      </div>
      <div>
        <strong>Company</strong>
        <a href="/partners">Partners</a>
        <a href="/corporate-social-responsibility">Social impact</a>
        <a href="/contact">Contact</a>
      </div>
    </nav>

    <div class="newsletter">
      <strong>Stay in the loop</strong>
      <p>Product updates and useful resources, sent occasionally.</p>
      <form data-api-form action="/api/newsletter" method="post">
        <label class="sr-only" for="newsletter-email">Email address</label>
        <input class="input" id="newsletter-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" maxlength="200" required />
        <button class="button button-primary" type="submit">Subscribe</button>
        <p class="form-status" data-form-status aria-live="polite"></p>
      </form>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {year} OurMicroSchool, a product of SYMVERGE PLATFORMS LLC.</span>
  </div>
</footer>

<style>
  .site-footer { margin-top: clamp(4.5rem, 9vw, 8rem); border-top: 1px solid var(--border); padding-block: clamp(3rem, 6vw, 5rem) 2rem; }
  .footer-grid { display: grid; grid-template-columns: 1.15fr 0.9fr 1fr; gap: clamp(2rem, 6vw, 5rem); }
  .footer-brand a { display: inline-flex; align-items: center; gap: 0.65rem; font-size: 1rem; letter-spacing: -0.02em; }
  .footer-brand img { width: 2.2rem; height: 2.2rem; border-radius: 0.6rem; object-fit: cover; }
  .footer-brand p, .newsletter p { max-width: 24rem; margin-top: 0.9rem; color: var(--ink-soft); font-size: 0.9rem; }
  .footer-brand > span { display: block; margin-top: 1rem; color: var(--ink-faint); font-size: 0.78rem; font-weight: 700; }
  .footer-links { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
  .footer-links div { display: grid; align-content: start; gap: 0.6rem; }
  .footer-links strong, .newsletter > strong { margin-bottom: 0.2rem; font-size: 0.82rem; }
  .footer-links a { color: var(--ink-soft); font-size: 0.86rem; font-weight: 650; }
  .footer-links a:hover { color: var(--primary); }
  .newsletter form { display: grid; grid-template-columns: 1fr auto; gap: 0.55rem; margin-top: 1rem; }
  .newsletter .button { min-height: 3rem; padding-inline: 1.2rem; }
  .newsletter .form-status { grid-column: 1 / -1; margin: 0; }
  .footer-bottom { display: flex; justify-content: flex-start; gap: 1rem; margin-top: 3.5rem; border-top: 1px solid var(--border); padding-top: 1.3rem; color: var(--ink-faint); font-size: 0.75rem; font-weight: 650; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (max-width: 52rem) { .footer-grid { grid-template-columns: 1fr 1fr; } .newsletter { grid-column: 1 / -1; } }
  @media (max-width: 36rem) { .footer-grid { grid-template-columns: 1fr; } .newsletter { grid-column: auto; } .newsletter form { grid-template-columns: 1fr; } .footer-bottom { flex-direction: column; } }
</style>
