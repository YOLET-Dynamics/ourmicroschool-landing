---
type Props = {
  eyebrow: string;
  title: string;
  accent: string;
  lead: string;
};
const { eyebrow, title, accent, lead } = Astro.props;
---

<header class="page-hero container hero-enter">
  <p class="eyebrow">{eyebrow}</p>
  <h1 class="heading-xl">{title} <span class="accent-text">{accent}</span></h1>
  <p class="lead">{lead}</p>
</header>

<style>
  .page-hero { max-width: 73.75rem; padding-block: clamp(5rem, 10vw, 8rem) clamp(2.25rem, 5vw, 4rem); }
  .page-hero h1 { max-width: 50rem; margin-top: 0.8rem; }
  .page-hero .lead { max-width: 43rem; margin-top: 1.2rem; }
</style>
